# Copia este archivo a .env.local y completa los valores. .env.local no se sube al repositorio.

# Dominio público de producción, con https y sin barra final (se ignora si la lleva).
# Se usa para canonical, Open Graph, robots.txt y sitemap. Sin este valor el sitio queda en noindex.
# Solo se indexa en producción (NODE_ENV=production y VERCEL_ENV distinto de "preview").
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com

# Cloudinary: panel /admin, imágenes del sitio e imagen social. Cuenta en cloudinary.com > Settings > API Keys.
# Sin estos valores el sitio usa las imágenes locales de /public y /admin avisa.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Acceso privado a /admin. Generar hash y secreto con: node scripts/hash-password.mjs "contraseña"
ADMIN_USER=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Opcionales
# Etiqueta de verificación de Google Search Console (solo el valor del content).
GOOGLE_SITE_VERIFICATION=
# ID de Google Analytics 4 (formato G-XXXXXXXXXX). Solo se carga en producción.
NEXT_PUBLIC_GA_ID=

# Formulario de contacto por correo (Resend, resend.com > API Keys). Sin estas variables el formulario ofrece WhatsApp.
RESEND_API_KEY=
# Correo(s) que reciben los mensajes; varios separados por coma.
CONTACT_TO_EMAIL=
# Remitente. Sin dominio verificado en Resend solo funciona el de prueba (y solo envía al correo de la cuenta de Resend).
# Con dominio verificado: BKTX Soluciones Textiles <contacto@tu-dominio.com>
CONTACT_FROM_EMAIL=
